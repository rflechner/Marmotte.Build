<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Centralisation des versions NuGet : chaque package référencé par un projet
         de la solution déclare sa version ici (PackageVersion), et les PackageReference
         des .csproj n'ont plus d'attribut Version. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

</Project>
